<Window x:Class="SystemDiagnoseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SystemDiagnoseApp.ViewModels"
        Title="System Diagnose — Windows slowness checker"
        Height="820" Width="1000" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Diagnose why this PC is slow to open programs"
                           FontSize="18" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,10"
                           Text="Runs a set of read-only checks, then lets you apply fixes one at a time. Every fix asks for confirmation first and is written to a log on the Desktop." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Run diagnostics" Command="{Binding RunCommand}" FontWeight="SemiBold" MinWidth="130" />
                    <Button Content="Stop" Command="{Binding CancelCommand}" />
                    <Button Content="Save report to Desktop" Command="{Binding ExportCommand}" MinWidth="160" />
                    <Button Content="Open action log" Command="{Binding OpenActionLogCommand}" MinWidth="120" />
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                </Grid>
                <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Activity log at the bottom -->
        <Expander DockPanel.Dock="Bottom" Header="Activity / fix output" IsExpanded="False" Margin="0,10,0,0">
            <ListBox ItemsSource="{Binding Activity}" Height="150"
                     FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Expander>

        <!-- Results -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CheckResultViewModel}">
                        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding SeverityBrush}" CornerRadius="4"
                                            Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SeverityText}" Foreground="White"
                                                   FontWeight="Bold" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           FontFamily="Consolas" FontSize="12" />

                                <Border Background="#22EF6C00" BorderBrush="#EF6C00" BorderThickness="0,0,0,0"
                                        CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                                        Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="What to do" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FixViewModel}">
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Button Content="{Binding Title}" Command="{Binding ApplyCommand}"
                                                        MinWidth="60" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" Foreground="#555" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
